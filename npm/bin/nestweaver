#!/usr/bin/env bash
set -e
DIR="$(cd "$(dirname "$0")/.." && pwd)"
BINARY="$DIR/.nestweaver-bin/nestweaver"

if [ ! -x "$BINARY" ]; then
  echo "NestWeaver binary not found. Install a verified GitHub Release archive, or from a source checkout run: cargo install --locked --path ." >&2
  exit 1
fi

exec "$BINARY" "$@"
