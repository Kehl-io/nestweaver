{
  "hooks": {
    "SessionStart": [{
      "hooks": [{
        "type": "command",
        "command": "nestweaver brain status --db \"${NESTWEAVER_DB:-$CLAUDE_PROJECT_DIR/nestweaver.lbug}\" 2>/dev/null || true"
      }]
    }],
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [{
          "type": "command",
          "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/nestweaver/pre-read-enrich.sh\""
        }]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [{
          "type": "command",
          "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/nestweaver/post-edit-impact.sh\""
        }]
      },
      {
        "matcher": "Bash",
        "hooks": [{
          "type": "command",
          "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/nestweaver/pre-search-enrich.sh\""
        }]
      }
    ],
    "PostToolUse": [{
      "matcher": "Bash",
      "hooks": [{
        "type": "command",
        "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/nestweaver/post-commit-stale-check.sh\""
      }]
    }]
  }
}
