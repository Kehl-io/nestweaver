CREATE NODE TABLE RegexScopeState(uid STRING, desired_epoch INT64, acknowledged_epoch INT64, candidate_count INT64, candidate_digest STRING, tombstone BOOL, last_error STRING, PRIMARY KEY(uid))
CREATE NODE TABLE Contract(uid STRING, kind STRING, verb STRING, path STRING, operation_id STRING, repo_uid STRING, source_path STRING, confidence FLOAT, PRIMARY KEY(uid))
CREATE NODE TABLE Symbol(uid STRING, name STRING, kind STRING, repo_uid STRING, file_path STRING, start_line INT64, end_line INT64, signature STRING, summary STRING, content_hash STRING, pagerank_score DOUBLE, is_entry_point STRING, entry_point_kind STRING, framework_hint STRING, canonical_id STRING, visibility STRING, PRIMARY KEY(uid))
CREATE NODE TABLE Note(uid STRING, vault_uid STRING, file_path STRING, title STRING, note_kind STRING, word_count INT64, content_hash STRING, frontmatter STRING, frontmatter_raw STRING, created_at STRING, modified_at STRING, pagerank_score DOUBLE, PRIMARY KEY(uid))
CREATE NODE TABLE Section(uid STRING, note_uid STRING, heading_uid STRING, start_line INT64, end_line INT64, text_hash STRING, text_content STRING, word_count INT64, pagerank_score DOUBLE, PRIMARY KEY(uid))
CREATE NODE TABLE Vault(uid STRING, name STRING, root_path STRING, instance_id STRING, PRIMARY KEY(uid))
CREATE NODE TABLE Heading(uid STRING, note_uid STRING, level INT64, text STRING, slug STRING, start_line INT64, end_line INT64, content_hash STRING, PRIMARY KEY(uid))
CREATE NODE TABLE Repo(uid STRING, url STRING, indexed_sha STRING, staleness_commits_behind INT64, instance_id STRING, name STRING, root_path STRING, PRIMARY KEY(uid))
CREATE NODE TABLE RegexScopeOutbox(uid STRING, desired_epoch INT64, PRIMARY KEY(uid))
CREATE NODE TABLE Tag(uid STRING, vault_uid STRING, name STRING, PRIMARY KEY(uid))
CREATE NODE TABLE Meta(key STRING, value STRING, PRIMARY KEY(key))
CREATE NODE TABLE UnresolvedWikilink(uid STRING, source_note_uid STRING, source_path STRING, source_title STRING, wikilink_text STRING, PRIMARY KEY(uid))
CREATE NODE TABLE Project(uid STRING, name STRING, summary STRING, instance_id STRING, PRIMARY KEY(uid))
CREATE NODE TABLE File(uid STRING, path STRING, repo_uid STRING, content_hash STRING, PRIMARY KEY(uid))
CREATE NODE TABLE Service(uid STRING, name STRING, repo_uid STRING, summary STRING, summary_hash STRING, PRIMARY KEY(uid))
CREATE REL TABLE FILE_HAS_SYMBOL(FROM File TO Symbol)
CREATE REL TABLE ACCESSES(FROM Symbol TO Symbol, confidence FLOAT, evidence STRING)
CREATE REL TABLE EXTENDS_SYM(FROM Symbol TO Symbol, confidence FLOAT, evidence STRING)
CREATE REL TABLE SERVICE_HAS_SYMBOL(FROM Service TO Symbol)
CREATE REL TABLE NOTE_HAS_SECTION(FROM Note TO Section)
CREATE REL TABLE NOTE_TAGGED_WITH(FROM Note TO Tag)
CREATE REL TABLE IMPLEMENTS_SYM(FROM Symbol TO Symbol, confidence FLOAT, evidence STRING)
CREATE REL TABLE INCLUDES_SYM(FROM Symbol TO Symbol, confidence FLOAT, evidence STRING)
CREATE REL TABLE MEMBER_OF(FROM Symbol TO Symbol, confidence FLOAT, evidence STRING)
CREATE REL TABLE CALLS(FROM Symbol TO Symbol, confidence FLOAT, evidence STRING)
CREATE REL TABLE WIKILINK_TO_NOTE(FROM Section TO Note, confidence FLOAT, display STRING, target STRING)
CREATE REL TABLE CAUSED_BY(FROM Note TO Note, confidence FLOAT, evidence STRING)
CREATE REL TABLE NOTE_HAS_HEADING(FROM Note TO Heading)
CREATE REL TABLE REPO_HAS_FILE(FROM Repo TO File)
CREATE REL TABLE HEADING_PARENT(FROM Heading TO Heading)
CREATE REL TABLE IMPORTS(FROM Symbol TO Symbol, confidence FLOAT, evidence STRING)
CREATE REL TABLE PROJECT_HAS_PARENT(FROM Project TO Project, confidence FLOAT)
CREATE REL TABLE RELATES_TO(FROM Note TO Note, confidence FLOAT, evidence STRING)
CREATE REL TABLE PROJECT_INCLUDES_REPO(FROM Project TO Repo, confidence FLOAT)
CREATE REL TABLE WIKILINK_TO_HEADING(FROM Section TO Heading, confidence FLOAT, display STRING, target STRING)
CREATE REL TABLE IMPLEMENTS_CONTRACT(FROM Symbol TO Contract, confidence FLOAT, evidence STRING)
CREATE REL TABLE REFERENCES_CODE_SECTION_TO_SYMBOL(FROM Section TO Symbol, confidence FLOAT, source STRING)
CREATE REL TABLE SUPERSEDES(FROM Note TO Note, confidence FLOAT, evidence STRING)
CREATE REL TABLE VAULT_HAS_NOTE(FROM Vault TO Note)
CREATE REL TABLE PROJECT_INCLUDES_NOTE(FROM Project TO Note, confidence FLOAT)
CREATE REL TABLE USES(FROM Symbol TO Symbol, confidence FLOAT, evidence STRING)
CREATE REL TABLE PROJECT_INCLUDES_SYMBOL(FROM Project TO Symbol, confidence FLOAT)
CREATE REL TABLE CROSS_REPO_LINK(FROM Symbol TO Symbol, confidence FLOAT, link_type STRING, evidence STRING)
CREATE REL TABLE DEPENDS_ON(FROM Note TO Note, confidence FLOAT, evidence STRING)
CREATE REL TABLE PROJECT_HAS_COMPONENT(FROM Project TO Project, confidence FLOAT)
CREATE REL TABLE REFERENCES_CODE_NOTE_TO_SYMBOL(FROM Note TO Symbol, confidence FLOAT, source STRING)
CREATE REL TABLE SECTION_TAGGED_WITH(FROM Section TO Tag)
CREATE REL TABLE HEADING_HAS_SECTION(FROM Heading TO Section)
